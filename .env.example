# ---------- Database ----------
# Supabase (Postgres): Project -> Connect -> "Session pooler" connection string (port 5432)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# MongoDB still works too: a mongodb:// or mongodb+srv:// URL switches the adapter automatically
# DATABASE_URL=mongodb://127.0.0.1/your-database-name
# Set to false only for a local Postgres without SSL
# DATABASE_SSL=false

PAYLOAD_SECRET=YOUR_SECRET_HERE

# ---------- Media storage (optional: Supabase Storage) ----------
# Leave S3_BUCKET empty to store uploads on local disk (public/media).
# Supabase: Storage -> create a bucket (public) -> Settings -> S3 access keys
S3_BUCKET=
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=<region>
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- One-off migration from MongoDB (npm run db:export) ----------
# MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/db
# Where to download media files from if they're not in public/media (the old running site)
# MEDIA_SOURCE_URL=http://localhost:3000
